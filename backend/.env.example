NODE_ENV=development
PORT=3333

# MongoDB (local via docker compose, ou string do MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/paraflow

# Gere um segredo longo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dce654294e4d2662ee0a693ad188cd060445bc15d2bb6a811b3ed5325a36193643e25e87c2e9eebe532f8cc6774e7b1e
JWT_EXPIRES_IN=7d

# Origens permitidas (web). Separe por vírgula.
CORS_ORIGINS=http://localhost:5173

# MQTT. Deixe vazio para rodar o backend sem broker.
# Local:  mqtt://localhost:1883
# Wokwi:  mqtt://broker.hivemq.com:1883 (broker PÚBLICO: use um prefixo único!)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=paraflow
DEFAULT_DEVICE_ID=esp32-01

# Permite POST /api/eventos (simulação sem hardware). Use false em produção.
ALLOW_SIMULATION=true
